!DOCTYPE html>
<html lang="en">
<head><
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our One Month Anniversary 💗</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Georgia, serif;
  min-height: 100vh;
  overflow: hidden;
  color: #a52e65;
  background: linear-gradient(135deg,#ffe0ec,#ffb9d2,#fff0f6);
}

#hearts {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.heart {
  position: absolute;
  bottom: -40px;
  animation: floatUp linear infinite;
  opacity: .7;
}

@keyframes floatUp {
  0% { transform: translateY(0) rotate(0); opacity: 0; }
  20% { opacity: .8; }
  100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
}

header {
  height: 7vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  letter-spacing: 3px;
  position: relative;
  z-index: 2;
}

#book {
  width: min(92vw,440px);
  height: 86vh;
  max-height: 850px;
  margin: auto;
  position: relative;
  perspective: 1200px;
  z-index: 1;
}

.page {
  position: absolute;
  inset: 0;
  display: none;
  padding: 24px 18px;
  border: 2px solid white;
  border-radius: 22px;
  background: linear-gradient(145deg,#fffafd,#ffeaf2);
  box-shadow: 0 12px 35px #bd568455,
              inset 0 0 20px #ffc6dc77;
  text-align: center;
  overflow-y: auto;
  scrollbar-width: none;
}

.page::-webkit-scrollbar {
  display: none;
}

.page.active {
  display: block;
  animation: pageEnter .65s ease both;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: perspective(900px) rotateY(-15deg) translateX(25px) scale(.94);
  }
  to {
    opacity: 1;
    transform: perspective(900px) rotateY(0) translateX(0) scale(1);
  }
}

.page-number {
  font-size: 10px;
  letter-spacing: 3px;
  color: #d77b9e;
  margin-bottom: 15px;
}

h1 {
  font-size: clamp(32px,9vw,45px);
  color: #e63e82;
  text-shadow: 2px 3px 12px #ffb7d1;
  line-height: 1.2;
}

h2 {
  font-size: 27px;
  color: #d83b79;
  margin: 13px 0;
}

p {
  line-height: 1.8;
}

.cover {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-heart {
  font-size: 75px;
  animation: heartbeat 1.3s infinite;
}

@keyframes heartbeat {
  0%,100% { transform: scale(1); }
  50% { transform: scale(1.23); }
}

.small-title {
  font-size: 10px;
  letter-spacing: 4px;
  margin: 15px 0;
}

.love-text {
  font-size: 16px;
  margin-top: 15px;
}

.timer-title {
  margin-top: 28px;
  font-size: 12px;
  letter-spacing: 2px;
}

.timer {
  display: flex;
  gap: 7px;
  width: 100%;
  margin-top: 14px;
}

.timer div {
  flex: 1;
  background: linear-gradient(145deg,#ffb6d2,#ed5994);
  color: white;
  padding: 13px 3px;
  border-radius: 14px;
  box-shadow: 0 5px 13px #e88aaa;
}

.timer span {
  display: block;
  font-size: clamp(18px,5vw,25px);
  font-weight: bold;
}

.timer small {
  font-size: 9px;
}

.forever {
  margin-top: 24px;
  font-style: italic;
  font-size: 14px;
}

.photo-page {
  display: none;
  flex-direction: column;
  align-items: center;
}

.photo-page.active {
  display: flex;
}

.photo-frame {
  width: 100%;
  max-width: 340px;
  aspect-ratio: 4 / 5;
  border: 4px solid white;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 25px #d76d9877;
  background: #ffd5e5;
  animation: photoGlow 3s infinite alternate;
}

@keyframes photoGlow {
  from { box-shadow: 0 5px 15px #e58bad66; }
  to { box-shadow: 0 8px 30px #ed70a8cc; }
}

.photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.compliment {
  font-size: 17px;
  font-style: italic;
  margin-top: 20px;
  padding: 0 8px;
  animation: textReveal 1.2s ease both;
}

@keyframes textReveal {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.decorative {
  font-size: 38px;
  margin: 20px 0;
  animation: heartbeat 2s infinite;
}

.quote {
  font-size: 22px;
  line-height: 1.8;
  font-style: italic;
  margin-top: 45px;
  animation: textReveal 1s ease both;
}

.note-card {
  background: #ffe0ec;
  padding: 25px 17px;
  border-radius: 18px;
  margin-top: 25px;
  box-shadow: inset 0 0 15px #f8b4cf;
  animation: cardFloat 3s ease-in-out infinite;
}

@keyframes cardFloat {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.envelope {
  font-size: 85px;
  margin: 25px;
  cursor: pointer;
  animation: heartbeat 1.5s infinite;
}

.letter-content {
  display: none;
  text-align: left;
  line-height: 1.9;
  background: white;
  padding: 18px;
  border-radius: 13px;
  margin-top: 15px;
}

.fingerprint {
  font-size: 90px;
  margin: 35px 0 15px;
  display: inline-block;
  padding: 20px;
  border: 3px solid #ed78a8;
  border-radius: 50%;
  box-shadow: 0 0 25px #ffb1cf;
  touch-action: none;
  user-select: none;
}

.reveal {
  display: none;
  font-size: 38px;
  color: #e52e78;
  font-weight: bold;
  margin-top: 30px;
  animation: revealLove 1s ease;
}

@keyframes revealLove {
  from { transform: scale(.2) rotate(-10deg); opacity: 0; }
  to { transform: scale(1) rotate(0); opacity: 1; }
}

#pageCounter {
  position: absolute;
  bottom: 10px;
  right: 15px;
  font-size: 11px;
  color: #c36b8d;
}

#hint {
  height: 7vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  letter-spacing: 1px;
  position: relative;
  z-index: 2;
}

</style>
</head>

