<script>

/* FLOATING HEARTS */
const heartContainer = document.getElementById("hearts");

for(let i=0;i<22;i++){
const heart=document.createElement("div");
heart.className="heart";
heart.textContent=["💗","💕","💖","♡","🌸"][i%5];
heart.style.left=Math.random()*100+"%";
heart.style.animationDuration=(7+Math.random()*8)+"s";
heart.style.animationDelay=(Math.random()*8)+"s";
heart.style.fontSize=(15+Math.random()*20)+"px";
heartContainer.appendChild(heart);
}

/* TIMER */
function updateTimer(){

const start=new Date(2026,9,17,0,0,0);
const now=new Date();
const diff=Math.max(0,now-start);

const days=Math.floor(diff/86400000);
const hours=Math.floor(diff/3600000)%24;
const minutes=Math.floor(diff/60000)%60;
const seconds=Math.floor(diff/1000)%60;

document.getElementById("days").textContent=days;
document.getElementById("hours").textContent=String(hours).padStart(2,"0");
document.getElementById("minutes").textContent=String(minutes).padStart(2,"0");
document.getElementById("seconds").textContent=String(seconds).padStart(2,"0");

}

updateTimer();
setInterval(updateTimer,1000);

/* PAGE NAVIGATION */
const pages=document.querySelectorAll(".page");
let currentPage=0;

function showPage(index){

if(index<0||index>=pages.length)return;

pages[currentPage].classList.remove("active");
currentPage=index;
pages[currentPage].classList.add("active");

document.getElementById("pageCounter").textContent=
(currentPage+1)+" / "+pages.length;

}

let startX=0;
let startY=0;

const book=document.getElementById("book");

book.addEventListener("touchstart",function(e){
startX=e.changedTouches[0].screenX;
startY=e.changedTouches[0].screenY;
},{passive:true});

book.addEventListener("touchend",function(e){

if(e.target.closest(".envelope")||
e.target.closest(".fingerprint"))return;

const dx=e.changedTouches[0].screenX-startX;
const dy=e.changedTouches[0].screenY-startY;

if(Math.abs(dx)>55&&Math.abs(dx)>Math.abs(dy)){
if(dx<0)showPage(currentPage+1);
else showPage(currentPage-1);
}

},{passive:true});

/* LETTER */
document.getElementById("envelope").addEventListener("click",function(){

const letter=document.getElementById("letter");

if(letter.style.display==="block"){
letter.style.display="none";
this.textContent="💌";
}else{
letter.style.display="block";
this.textContent="💖";
}

});

/* FINGERPRINT SURPRISE */
const fingerprint=document.getElementById("fingerprint");
const lockMessage=document.getElementById("lockMessage");
const reveal=document.getElementById("reveal");

let holdTimer=null;

function startHold(e){

e.preventDefault();
if(holdTimer)return;

lockMessage.textContent="Keep holding... 💗";

holdTimer=setTimeout(()=>{

reveal.style.display="block";
lockMessage.textContent="Surprise unlocked! 💕";
fingerprint.textContent="💖";
holdTimer=null;

},1200);

}

function cancelHold(){

if(holdTimer){
clearTimeout(holdTimer);
holdTimer=null;
lockMessage.textContent="Try holding again 💗";
}

}

fingerprint.addEventListener("pointerdown",startHold);
fingerprint.addEventListener("pointerup",cancelHold);
fingerprint.addEventListener("pointerleave",cancelHold);
fingerprint.addEventListener("pointercancel",cancelHold);

</script>

