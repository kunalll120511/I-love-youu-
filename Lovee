<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Georgia, serif;
  min-height: 100vh;
  overflow: hidden;
  color: #a52e65;
  background: linear-gradient(135deg,#ffe0ec,#ffb9d2,#fff0f6);
}

#hearts {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.heart {
  position: absolute;
  bottom: -40px;
  animation: floatUp linear infinite;
  opacity: .7;
}

@keyframes floatUp {
  0% { transform: translateY(0) rotate(0); opacity: 0; }
  20% { opacity: .8; }
  100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
}

header {
  height: 7vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  letter-spacing: 3px;
  position: relative;
  z-index: 2;
}

#book {
  width: min(92vw,440px);
  height: 86vh;
  max-height: 850px;
  margin: auto;
  position: relative;
  perspective: 1200px;
  z-index: 1;
}

.page {
  position: absolute;
  inset: 0;
  display: none;
  padding: 24px 18px;
  border: 2px solid white;
  border-radius: 22px;
  background: linear-gradient(145deg,#fffafd,#ffeaf2);
  box-shadow: 0 12px 35px #bd568455,
              inset 0 0 20px #ffc6dc77;
  text-align: center;
  overflow-y: auto;
  scrollbar-width: none;
}

.page::-webkit-scrollbar {
  display: none;
}

.page.active {
  display: block;
  animation: pageEnter .65s ease both;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: perspective(900px) rotateY(-15deg) translateX(25px) scale(.94);
  }
  to {
    opacity: 1;
    transform: perspective(900px) rotateY(0) translateX(0) scale(1);
  }
}
page-number {
  font-size: 10px;
  letter-spacing: 3px;
  color: #d77b9e;
  margin-bottom: 15px;
}

h1 {
